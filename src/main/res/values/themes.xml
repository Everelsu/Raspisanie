<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Nothing Design -->
    <style name="Base.Theme.Raspisanie" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/textPrimary</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="settingsCardBg">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
    </style>

    <style name="Theme.Raspisanie" parent="Base.Theme.Raspisanie">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Light Theme - Точная копия Dark темы с инвертированными цветами -->
    <style name="Theme.Raspisanie.Light" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Фон окна (инвертирован от темной: #000000 -> #FFFFFF) -->
        <item name="android:windowBackground">@color/light_windowBackground</item>
        
        <!-- Основной цвет темы (инвертирован: #FFFFFF -> #000000) -->
        <item name="colorPrimary">@color/light_colorPrimary</item>
        <item name="colorOnPrimary">@color/light_colorOnPrimary</item>
        <item name="colorPrimaryVariant">@color/light_colorPrimaryVariant</item>
        
        <!-- Цвет поверхности (инвертирован: #000000 -> #FFFFFF) -->
        <item name="colorSurface">@color/light_colorSurface</item>
        <item name="colorOnSurface">@color/light_colorOnSurface</item>
        
        <!-- Фон карточек в настройках (инвертирован: #1A1A1A -> #F5F5F5, а не белый!) -->
        <item name="settingsCardBg">@color/light_settingsCardBg</item>
        
        <!-- Статус бар -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        
        <!-- Навигационная панель (инвертирован: #000000 -> #FFFFFF) -->
        <item name="android:navigationBarColor">@color/light_navigationBarColor</item>
        
        <!-- Инвертированный статус бар (false -> true) -->
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Шрифт -->
        <item name="android:fontFamily">@font/inter</item>
        
        <!-- Цвет текста (инвертирован: #FFFFFF -> #000000) -->
        <item name="android:textColor">@color/light_textColor</item>
        <item name="android:textColorPrimary">@color/light_textColorPrimary</item>
        <item name="android:textColorSecondary">@color/light_textColorSecondary</item>
        
        <!-- Фон и текст на фоне (инвертирован) -->
        <item name="android:colorBackground">@color/light_colorBackground</item>
        <item name="colorOnBackground">@color/light_colorOnBackground</item>
        
        <!-- Цвета для кнопок и switches (чтобы не было фиолетового) -->
        <item name="colorControlActivated">@color/light_colorPrimary</item>
        <item name="colorControlNormal">@color/light_textColorSecondary</item>
        <item name="android:colorControlActivated">@color/light_colorPrimary</item>
        <item name="android:colorControlNormal">@color/light_textColorSecondary</item>
        <!-- Button styles to override Material3 purple -->
        <item name="materialButtonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="buttonStyle">@style/Widget.Raspisanie.Button</item>
        <!-- Apply Switch style to disable MaterialThemeColors purple -->
        <item name="switchStyle">@style/SettingsSwitch</item>
        <!-- Switch colors -->
        <item name="switchThumbTint">@color/switch_thumb_light</item>
        <item name="switchTrackTint">@color/switch_track_light</item>
        <item name="thumbTint">@color/switch_thumb_light</item>
        <item name="trackTint">@color/switch_track_light</item>
        <!-- Lesson number colors -->
        <item name="lessonNumberBg">@color/light_lessonNumberBg</item>
        <item name="lessonNumberStroke">@color/light_lessonNumberStroke</item>
    </style>

    <!-- Dark Theme -->
    <!-- Используем DayNight как базу, но принудительно темная -->
    <style name="Theme.Raspisanie.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Фон окна -->
        <item name="android:windowBackground">@color/dark_windowBackground</item>
        
        <!-- Основной цвет темы -->
        <item name="colorPrimary">@color/dark_colorPrimary</item>
        <item name="colorOnPrimary">@color/dark_colorOnPrimary</item>
        <item name="colorPrimaryVariant">@color/dark_colorPrimaryVariant</item>
        
        <!-- Цвет поверхности -->
        <item name="colorSurface">@color/dark_colorSurface</item>
        <item name="colorOnSurface">@color/dark_colorOnSurface</item>
        
        <!-- Фон карточек в настройках -->
        <item name="settingsCardBg">@color/dark_settingsCardBg</item>
        
        <!-- Статус бар -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        
        <!-- Навигационная панель -->
        <item name="android:navigationBarColor">@color/dark_navigationBarColor</item>
        
        <!-- Темный статус бар (белые иконки) -->
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Шрифт -->
        <item name="android:fontFamily">@font/inter</item>
        
        <!-- Цвет текста -->
        <item name="android:textColor">@color/dark_textColor</item>
        <item name="android:textColorPrimary">@color/dark_textColorPrimary</item>
        <item name="android:textColorSecondary">@color/dark_textColorSecondary</item>
        
        <!-- Фон и текст на фоне -->
        <item name="android:colorBackground">@color/dark_colorBackground</item>
        <item name="colorOnBackground">@color/dark_colorOnBackground</item>
        
        <!-- Цвета для кнопок и switches -->
        <item name="colorControlActivated">@color/dark_colorPrimary</item>
        <item name="colorControlNormal">@color/dark_textColorSecondary</item>
        <item name="android:colorControlActivated">@color/dark_colorPrimary</item>
        <item name="android:colorControlNormal">@color/dark_textColorSecondary</item>
        <!-- Button styles to override Material3 purple -->
        <item name="materialButtonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="buttonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="switchStyle">@style/SettingsSwitch</item>
        <!-- Switch colors -->
        <item name="switchThumbTint">@color/switch_thumb_dark</item>
        <item name="switchTrackTint">@color/switch_track_dark</item>
        <item name="thumbTint">@color/switch_thumb_dark</item>
        <item name="trackTint">@color/switch_track_dark</item>
        <!-- Lesson number colors -->
        <item name="lessonNumberBg">@color/dark_lessonNumberBg</item>
        <item name="lessonNumberStroke">@color/dark_lessonNumberStroke</item>
    </style>

    <!-- Custom Theme - Темная основа с хеллоуин акцентами -->
    <!-- Основана на Dark теме, но с оранжевым хеллоуин акцентом вместо белого -->
    <style name="Theme.Raspisanie.Custom" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Фон окна (темный как в Dark) -->
        <item name="android:windowBackground">@color/custom_windowBackground</item>
        
        <!-- Основной цвет (хеллоуин оранжевый вместо белого) -->
        <item name="colorPrimary">@color/custom_colorPrimary</item>
        <item name="colorOnPrimary">@color/custom_colorOnPrimary</item>
        <item name="colorPrimaryVariant">@color/custom_colorPrimaryVariant</item>
        
        <!-- Цвет поверхности (темный как в Dark) -->
        <item name="colorSurface">@color/custom_colorSurface</item>
        <item name="colorOnSurface">@color/custom_colorOnSurface</item>
        
        <!-- Фон карточек в настройках (темный как в Dark) -->
        <item name="settingsCardBg">@color/custom_settingsCardBg</item>
        
        <!-- Статус бар -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        
        <!-- Навигационная панель (темная как в Dark) -->
        <item name="android:navigationBarColor">@color/custom_navigationBarColor</item>
        
        <!-- Темный статус бар (как в Dark) -->
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Шрифт -->
        <item name="android:fontFamily">@font/inter</item>
        
        <!-- Цвет текста (белый как в Dark) -->
        <item name="android:textColor">@color/custom_textColor</item>
        <item name="android:textColorPrimary">@color/custom_textColorPrimary</item>
        <item name="android:textColorSecondary">@color/custom_textColorSecondary</item>
        
        <!-- Фон и текст на фоне (темные как в Dark) -->
        <item name="android:colorBackground">@color/custom_colorBackground</item>
        <item name="colorOnBackground">@color/custom_colorOnBackground</item>
        
        <!-- Цвета для кнопок и switches (хеллоуин оранжевый акцент) -->
        <item name="colorControlActivated">@color/custom_colorPrimary</item>
        <item name="colorControlNormal">@color/custom_textColorSecondary</item>
        <item name="android:colorControlActivated">@color/custom_colorPrimary</item>
        <item name="android:colorControlNormal">@color/custom_textColorSecondary</item>
        <!-- Button styles to override Material3 purple -->
        <item name="materialButtonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="buttonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="switchStyle">@style/SettingsSwitch</item>
        <!-- Switch colors -->
        <item name="switchThumbTint">@color/switch_thumb_custom</item>
        <item name="switchTrackTint">@color/switch_track_custom</item>
        <item name="thumbTint">@color/switch_thumb_custom</item>
        <item name="trackTint">@color/switch_track_custom</item>
        <!-- Lesson number colors -->
        <item name="lessonNumberBg">@color/custom_lessonNumberBg</item>
        <item name="lessonNumberStroke">@color/custom_lessonNumberStroke</item>
    </style>

    <!-- Nothing Exclusive Theme - Красные акценты -->
    <style name="Theme.Raspisanie.Nothing" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Фон окна (черный) -->
        <item name="android:windowBackground">@color/nothing_windowBackground</item>
        
        <!-- Основной цвет (КРАСНЫЙ - можно менять здесь) -->
        <item name="colorPrimary">@color/nothing_colorPrimary</item>
        <item name="colorOnPrimary">@color/nothing_colorOnPrimary</item>
        <item name="colorPrimaryVariant">@color/nothing_colorPrimaryVariant</item>
        
        <!-- Вторичный цвет -->
        <item name="colorSecondary">@color/nothing_colorSecondary</item>
        <item name="colorOnSecondary">@color/nothing_colorOnSecondary</item>
        
        <!-- Цвет поверхности -->
        <item name="colorSurface">@color/nothing_colorSurface</item>
        <item name="colorOnSurface">@color/nothing_colorOnSurface</item>
        
        <!-- Фон карточек в настройках -->
        <item name="settingsCardBg">@color/nothing_settingsCardBg</item>
        
        <!-- Статус бар -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        
        <!-- Навигационная панель -->
        <item name="android:navigationBarColor">@color/nothing_navigationBarColor</item>
        
        <!-- Темный статус бар -->
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Шрифт Nothing (ndot) -->
        <item name="android:fontFamily">@font/ndot</item>
        
        <!-- Цвет текста -->
        <item name="android:textColor">@color/nothing_textColor</item>
        <item name="android:textColorPrimary">@color/nothing_textColorPrimary</item>
        <item name="android:textColorSecondary">@color/nothing_textColorSecondary</item>
        
        <!-- Фон и текст на фоне -->
        <item name="android:colorBackground">@color/nothing_colorBackground</item>
        <item name="colorOnBackground">@color/nothing_colorOnBackground</item>
        
        <!-- Цвета для меню и кнопок (используют colorPrimary = красный) -->
        <item name="actionMenuTextColor">@color/nothing_actionMenuTextColor</item>
        <item name="colorControlNormal">@color/nothing_colorControlNormal</item>
        <item name="colorControlActivated">@color/nothing_colorControlActivated</item>
        <item name="android:colorControlActivated">@color/nothing_colorControlActivated</item>
        <item name="android:colorControlNormal">@color/nothing_colorControlNormal</item>
        <!-- Button styles to override Material3 purple -->
        <item name="materialButtonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="buttonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="switchStyle">@style/SettingsSwitch</item>
        <!-- Switch colors -->
        <item name="switchThumbTint">@color/switch_thumb_nothing</item>
        <item name="switchTrackTint">@color/switch_track_nothing</item>
        <item name="thumbTint">@color/switch_thumb_nothing</item>
        <item name="trackTint">@color/switch_track_nothing</item>
        <!-- Lesson number colors -->
        <item name="lessonNumberBg">@color/nothing_lessonNumberBg</item>
        <item name="lessonNumberStroke">@color/nothing_lessonNumberStroke</item>
    </style>
</resources>