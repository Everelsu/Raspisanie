<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Nothing Design -->
    <style name="Base.Theme.Raspisanie" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/textPrimary</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="settingsCardBg">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
    </style>

    <style name="Theme.Raspisanie" parent="Base.Theme.Raspisanie">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- System Theme - Material3 DayNight с фиолетовыми акцентами -->
    <!-- Унифицирована под другие темы с той же структурой -->
    <style name="Theme.Raspisanie.System" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Фон окна (фиолетовый) -->
        <item name="android:windowBackground">@color/system_windowBackground</item>
        
        <!-- Цвет фона для обычного контента -->
        <item name="android:colorBackground">@color/system_windowBackground</item>
        
        <!-- Цвет поверхности (для карточек и т.п.) -->
        <item name="colorSurface">@color/system_colorSurface</item>
        <item name="colorOnSurface">@color/system_textColorPrimary</item>
        
        <!-- Основной цвет - фиолетовый Material3 (#6750A4) - оставляем стандартный -->
        
        <!-- Material3 dynamic colors - сохраняем фиолетовые акценты -->
        <!-- Цвета для кнопок и switches - используем стандартные Material3, но унифицируем стили -->
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?android:textColorSecondary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlNormal">?android:textColorSecondary</item>
        <!-- Button styles to match other themes -->
        <item name="materialButtonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="buttonStyle">@style/Widget.Raspisanie.Button</item>
        <!-- Switch colors - используем стандартные Material3 через DayNight (унифицировано) -->
        <!-- Switch colors управляются автоматически через Material3 DayNight -->
        <!-- Ripple colors - унифицированы с другими темами -->
        <item name="colorControlHighlight">@color/switch_ripple</item>
        <item name="android:colorControlHighlight">@color/switch_ripple</item>
        
        <!-- Фон карточек в настройках - через DayNight -->
        <item name="settingsCardBg">?attr/colorSurface</item>
        
        <!-- Статус бар -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        
        <!-- Навигационная панель -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- Статус бар - автоматически через DayNight -->
        
        <!-- Шрифт -->
        <item name="android:fontFamily">@font/inter</item>
        
        <!-- Цвет текста - явно задаем белый для фиолетовой темы для лучшей читаемости -->
        <item name="android:textColor">@color/system_textColorPrimary</item>
        <item name="android:textColorPrimary">@color/system_textColorPrimary</item>
        <item name="android:textColorSecondary">@color/system_textColorSecondary</item>
        
        <!-- Lesson number colors - унифицированы с другими темами -->
        <!-- Используем условные цвета для light/dark режимов через Material3 DayNight -->
        <!-- В светлом режиме автоматически будут светлые цвета, в тёмном - тёмные -->
        <item name="lessonNumberBg">?attr/colorSurfaceVariant</item>
        <item name="lessonNumberStroke">?attr/colorOutline</item>
    </style>

    <!-- Light Theme - Точная копия Dark темы с инвертированными цветами -->
    <style name="Theme.Raspisanie.Light" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Фон окна (инвертирован от темной: #000000 -> #FFFFFF) -->
        <item name="android:windowBackground">@color/light_windowBackground</item>
        
        <!-- Основной цвет темы (инвертирован: #FFFFFF -> #000000) -->
        <item name="colorPrimary">@color/light_colorPrimary</item>
        <item name="colorOnPrimary">@color/light_colorOnPrimary</item>
        <item name="colorPrimaryVariant">@color/light_colorPrimaryVariant</item>
        
        <!-- Material3 dynamic colors - убираем фиолетовый -->
        <item name="colorSecondary">@color/light_colorPrimary</item>
        <item name="colorTertiary">@color/light_colorPrimary</item>
        <item name="colorPrimaryContainer">@color/light_colorPrimary</item>
        <item name="colorSecondaryContainer">@color/light_colorPrimary</item>
        <item name="colorTertiaryContainer">@color/light_colorPrimary</item>
        
        <!-- Цвет поверхности (инвертирован: #000000 -> #FFFFFF) -->
        <item name="colorSurface">@color/light_colorSurface</item>
        <item name="colorOnSurface">@color/light_colorOnSurface</item>
        
        <!-- Фон карточек в настройках (инвертирован: #1A1A1A -> #F5F5F5, а не белый!) -->
        <item name="settingsCardBg">@color/light_settingsCardBg</item>
        
        <!-- Статус бар -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        
        <!-- Навигационная панель (инвертирован: #000000 -> #FFFFFF) -->
        <item name="android:navigationBarColor">@color/light_navigationBarColor</item>
        
        <!-- Инвертированный статус бар (false -> true) -->
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Шрифт -->
        <item name="android:fontFamily">@font/inter</item>
        
        <!-- Цвет текста (инвертирован: #FFFFFF -> #000000) -->
        <item name="android:textColor">@color/light_textColor</item>
        <item name="android:textColorPrimary">@color/light_textColorPrimary</item>
        <item name="android:textColorSecondary">@color/light_textColorSecondary</item>
        
        <!-- Фон и текст на фоне (инвертирован) -->
        <item name="android:colorBackground">@color/light_colorBackground</item>
        <item name="colorOnBackground">@color/light_colorOnBackground</item>
        
        <!-- Цвета для кнопок и switches (чтобы не было фиолетового) -->
        <item name="colorControlActivated">@color/light_colorPrimary</item>
        <item name="colorControlNormal">@color/light_textColorSecondary</item>
        <item name="android:colorControlActivated">@color/light_colorPrimary</item>
        <item name="android:colorControlNormal">@color/light_textColorSecondary</item>
        <!-- Button styles to override Material3 purple -->
        <item name="materialButtonStyle">@style/Widget.Raspisanie.Button</item>
        <item name="buttonStyle">@style/Widget.Raspisanie.Button</item>
        <!-- Switch colors -->
        <item name="switchThumbTint">@color/switch_thumb_light</item>
        <item name="switchTrackTint">@color/switch_track_light</item>
        <item name="thumbTint">@color/switch_thumb_light</item>
        <item name="trackTint">@color/switch_track_light</item>
        <!-- Ripple colors - убираем фиолетовый -->
        <item name="colorControlHighlight">@color/switch_ripple</item>
        <item name="android:colorControlHighlight">@color/switch_ripple</item>
        <!-- Lesson number colors -->
        <item name="lessonNumberBg">@color/light_lessonNumberBg</item>
        <item name="lessonNumberStroke">@color/light_lessonNumberStroke</item>
    </style>

