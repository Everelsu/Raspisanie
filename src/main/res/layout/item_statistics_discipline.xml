<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_background_dark">

    <!-- Прогресс-заполнение -->
    <View
        android:id="@+id/progressFill"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|top"
        android:alpha="0.3"
        android:background="@drawable/statistics_progress_fill_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <!-- Верхняя строка: номер, название, процент -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Номер -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp">

                <View
                    android:id="@+id/statNumberBg"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/lesson_number_bg" />

                <TextView
                    android:id="@+id/statNumberText"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Название -->
            <TextView
                android:id="@+id/statDisciplineText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="2"
                android:text="Дисциплина"
                android:textColor="?android:textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Процент -->
            <TextView
                android:id="@+id/statCompletionPercentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter"
                android:text="0%"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Преподаватель + тип занятия -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statTeacherText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:text="Преподаватель"
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/statLessonTypeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/subgroup_bg"
                android:fontFamily="@font/inter"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Лекция"
                android:textColor="?android:textColorSecondary"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Часы: компактная сетка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="42dp"
            android:orientation="horizontal">

            <!-- Всего -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Всего"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/statTotalHoursText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="—"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- План -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="План"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/statPlannedHoursText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="—"
                    android:textColor="@color/stat_planned"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Факт -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Факт"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/statFactHoursText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="—"
                    android:textColor="@color/stat_completed"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Остаток -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Остаток"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/statRemainingHoursText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="—"
                    android:textColor="@color/stat_remaining"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Дополнительная информация (скрыта по умолчанию) -->
        <LinearLayout
            android:id="@+id/statAdditionalInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="42dp"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="10dp"
                android:background="?android:attr/dividerHorizontal" />

            <!-- План в 2 нед / Факт в 2 нед -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:text="План 2 нед:"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/statPlannedIn2WeeksText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="—"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="11sp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Факт 2 нед:"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/statFactIn2WeeksText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter"
                    android:text="—"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Окончание -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Окончание:"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/statCompletionDateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter"
                    android:text="—"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
