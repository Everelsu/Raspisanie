<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="110dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/widget_lesson_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Предмет"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
            android:text="8:00 - 9:30"
                android:textSize="13sp"
            android:textColor="#757575"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Осталось 15 мин"
                android:textSize="11sp"
                android:textColor="#757575"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
            android:id="@+id/widget_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Аудитория 101"
            android:textSize="12sp"
            android:textColor="#757575"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_no_lesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нет пар"
        android:textSize="14sp"
        android:textColor="#757575"
        android:gravity="center"
        android:minHeight="110dp"
        android:visibility="gone" />


</LinearLayout>
