<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_background_gradient"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Основной контейнер с контентом -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Контейнер для фрагментов -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Нижняя навигационная панель -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="8dp"
            app:itemIconSize="26dp"
            app:itemIconTint="@color/bottom_nav_selector"
            app:itemTextColor="@color/bottom_nav_selector"
            app:itemTextAppearanceActive="@style/BottomNavTextAppearance"
            app:itemTextAppearanceInactive="@style/BottomNavTextAppearance"
            app:itemRippleColor="?attr/colorPrimaryContainer"
            app:menu="@menu/bottom_navigation"
            app:labelVisibilityMode="labeled"
            app:itemActiveIndicatorStyle="@style/BottomNavIndicator" />

    </LinearLayout>

    <!-- Снег для новогодней темы (поверх контента, но прозрачный для событий) -->
    <com.example.raspisanie.view.SnowfallView
        android:id="@+id/snowfallView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

</FrameLayout>