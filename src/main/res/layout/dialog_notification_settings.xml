<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/notificationsDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_settings_description"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/notification_settings_enable" />

    <TextView
        android:id="@+id/offsetLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/notification_settings_offset_label"
        android:textStyle="bold"
        android:textSize="14sp" />

    <RadioGroup
        android:id="@+id/radioGroupOffsets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/radioOffset0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_offset_0"
            android:tag="0" />

        <RadioButton
            android:id="@+id/radioOffset5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_offset_5"
            android:tag="5" />

        <RadioButton
            android:id="@+id/radioOffset10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_offset_10"
            android:tag="10" />

        <RadioButton
            android:id="@+id/radioOffset15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_offset_15"
            android:tag="15" />
    </RadioGroup>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchBreaks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/notification_settings_breaks" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchLunch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/notification_settings_lunch" />

</LinearLayout>



























