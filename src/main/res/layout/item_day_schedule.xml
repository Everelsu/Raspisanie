<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <FrameLayout
        android:id="@+id/cardBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:background="@drawable/card_background_dark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Понедельник"
                android:textSize="24sp"
                android:textColor="?android:textColorPrimary"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="30 октября"
                android:textSize="14sp"
                android:textColor="?android:textColorSecondary"
                android:fontFamily="@font/inter" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="?android:attr/dividerHorizontal" />

            <!-- Wrapper for progress line and items -->
            <FrameLayout
                android:id="@+id/itemsWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                
                <!-- Simple progress line -->
                <View
                    android:id="@+id/progressIndicator"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:background="@drawable/progress_indicator"
                    android:visibility="gone"
                    android:layout_marginStart="17dp"
                    android:layout_gravity="top|start"
                    android:elevation="-1dp" />
                
                <!-- Items container on top -->
                <LinearLayout
                    android:id="@+id/itemsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:elevation="1dp" />
                    
            </FrameLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
