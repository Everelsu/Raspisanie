<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">

    <!-- Circle with fixed size to prevent shifting -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:layout_gravity="center_vertical">

        <!-- Background circle -->
        <View
            android:id="@+id/circleBackground"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/lesson_number_bg" />

        <!-- Progress fill overlay - fills completely when lesson passed -->
        <View
            android:id="@+id/lessonProgressOverlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/lesson_progress_fill"
            android:visibility="gone"
            android:layout_gravity="center" />

        <!-- Number text on top -->
        <TextView
            android:id="@+id/lessonNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:elevation="2dp"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="1"
            android:textColor="?android:textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Предмет"
                android:textSize="16sp"
                android:textColor="?android:textColorPrimary"
                android:maxLines="2"
                android:ellipsize="end"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/subgroupIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="1"
                android:textSize="12sp"
                android:textColor="?android:textColorSecondary"
                android:background="@drawable/subgroup_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/lessonTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:15 - 9:15"
                android:textSize="11sp"
                android:textColor="?android:textColorSecondary"
                android:maxLines="1"
                android:letterSpacing="0.01"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Аудитория • Преподаватель"
                android:textSize="13sp"
                android:textColor="?android:textColorSecondary"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>