<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <TextView
        android:id="@+id/shareTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_schedule_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary" />

    <TextView
        android:id="@+id/shareSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_menu_hint"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginTop="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePrimary"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_day"
        android:layout_marginTop="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_share_24"
        app:iconTint="?attr/colorOnPrimary"
        android:textAllCaps="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareText"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_day_option_text"
        android:layout_marginTop="12dp"
        app:icon="@drawable/ic_share_24"
        app:iconTint="?android:textColorPrimary"
        android:textAllCaps="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopy"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_day_option_copy"
        android:layout_marginTop="4dp"
        app:icon="@drawable/ic_copy_24"
        app:iconTint="?android:textColorPrimary"
        android:textAllCaps="false" />

</LinearLayout>
