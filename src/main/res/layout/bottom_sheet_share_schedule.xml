<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    android:minHeight="200dp">

    <!-- Drag Handle (улучшенный) -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/drag_handle"
        android:alpha="0.5" />

    <!-- Заголовок -->
    <TextView
        android:id="@+id/shareTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_schedule_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary"
        android:letterSpacing="0.01"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp" />

    <!-- Подзаголовок -->
    <TextView
        android:id="@+id/shareSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_menu_hint"
        android:textSize="15sp"
        android:textColor="?android:textColorSecondary"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Основная кнопка "Поделиться" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePrimary"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="@string/share_day"
        android:layout_marginTop="28dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_share_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="?attr/colorOnPrimary"
        app:iconSize="22dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:maxLines="2"
        android:ellipsize="end"
        app:elevation="0dp" />

    <!-- Разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/listDivider"
        android:alpha="0.3" />

    <!-- Кнопка "Поделиться текстом" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShareText"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="@string/share_day_option_text"
        android:layout_marginTop="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:icon="@drawable/ic_share_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="?android:textColorPrimary"
        app:iconSize="20dp"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Кнопка "Копировать" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopy"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="@string/share_day_option_copy"
        android:layout_marginTop="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        app:icon="@drawable/ic_copy_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="?android:textColorPrimary"
        app:iconSize="20dp"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
