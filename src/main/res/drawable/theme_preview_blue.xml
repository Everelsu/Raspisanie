<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Фон (тёмный синий) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08101F" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Акцентный цвет (синий) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4C8DFF" />
            <corners android:radius="12dp" />
            <padding
                android:bottom="40dp"
                android:top="0dp"
                android:left="0dp"
                android:right="0dp" />
        </shape>
    </item>
</layer-list>


