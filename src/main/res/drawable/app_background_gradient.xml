<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Базовый градиентный фон -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="?android:colorBackground"
                android:centerColor="?android:colorBackground"
                android:endColor="?android:colorBackground"
                android:type="linear" />
        </shape>
    </item>
    <!-- Тонкая тень сверху (для глубины) -->
    <item android:bottom="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#08000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

