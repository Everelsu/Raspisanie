<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Фон (тёмно-зелёно-красный) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A1A0A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Зелёная полоса (больше зелёного) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E7D32" />
            <corners android:radius="12dp" />
            <padding
                android:bottom="40dp"
                android:top="0dp"
                android:left="0dp"
                android:right="0dp" />
        </shape>
    </item>
    <!-- Красная полоса -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C62828" />
            <corners android:radius="12dp" />
            <padding
                android:bottom="20dp"
                android:top="0dp"
                android:left="0dp"
                android:right="0dp" />
        </shape>
    </item>
</layer-list>

