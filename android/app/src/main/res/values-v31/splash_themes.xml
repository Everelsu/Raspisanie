<?xml version="1.0" encoding="utf-8"?>
<!-- Сплэш в цвет темы: назначается через SplashScreen.setSplashScreenTheme (API 33+)
     из MainActivity.setLauncherIcon вместе со сменой иконки. Не трогается
     flutter_native_splash (он пишет только styles.xml). -->
<resources>
    <style name="LaunchThemeDark" parent="LaunchTheme">
        <item name="android:windowBackground">#101010</item>
        <item name="android:windowSplashScreenBackground">#101010</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark_dark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#101010</item>
    </style>
    <style name="LaunchThemeLight" parent="LaunchTheme">
        <item name="android:windowBackground">#F2F2F7</item>
        <item name="android:windowSplashScreenBackground">#F2F2F7</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark_light</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F2F2F7</item>
    </style>
    <style name="LaunchThemeGreen" parent="LaunchTheme">
        <item name="android:windowBackground">#0C1A0C</item>
        <item name="android:windowSplashScreenBackground">#0C1A0C</item>
