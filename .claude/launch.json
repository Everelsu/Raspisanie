{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flutter-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "5959"
      ],
      "port": 5959
    },
    {
      "name": "web-release",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5960",
        "-d",
        "build/web"
      ],
      "port": 5960
    }
  ]
}
